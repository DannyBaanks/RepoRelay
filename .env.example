# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Google Cloud / Gemini
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)
GEMINI_MODEL=gemini-3.5-flash
# For Vertex AI-backed Gemini on Cloud Run:
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_LOCATION=global

# Protects /admin/* while /events/github remains public for GitHub webhooks.
ADMIN_TOKEN=

# Optional repository allowlist, comma-separated owner/repo names.
ALLOWED_REPOSITORIES=
MAX_LOG_LINES=200
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=1.0
